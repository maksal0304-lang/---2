            </div>
            <div class="about-image-container">
                <div class="decor-circles"></div>
                <!-- Замени смайлик внутри src на URL реальной картинки путешествий -->
                <img class="about-img" src="https://unsplash.com" alt="Adventure">
            </div>
        </section>

        <!-- РАЗДЕЛ 2: ПУТЁВКИ / УСЛУГИ -->
        <section style="margin-bottom: 60px;">
            <h2 class="section-title" style="text-align: center;">Направления экспедиций</h2>
